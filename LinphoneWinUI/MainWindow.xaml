<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LinphoneWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:local="using:LinphoneWinUI"
    xmlns:vm="using:LinphoneWinUI.ViewModels"
    Title="L-Phone">

    <Grid>
        <Grid.Resources>
            <!-- Круглая клавиша «а-ля iPhone». Фон и цвет цифр здесь НЕ задаём:
                 они тематические (см. ThemeDictionaries в ресурсах Dialpad). -->
            <Style x:Key="DialKey" TargetType="Button">
                <Setter Property="Width" Value="64" />
                <Setter Property="Height" Value="64" />
                <Setter Property="CornerRadius" Value="32" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="NavTab" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,6" />
            </Style>
            <Style x:Key="CircleBtn" TargetType="Button">
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="48" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Background" Value="#33FFFFFF" />
                <Setter Property="Foreground" Value="White" />
            </Style>
            <!-- Круглая кнопка экрана разговора (а-ля iPhone). Фон/цвет НЕ задаём:
                 они приходят из ThemeDictionaries секции InCallSection — та же палитра,
                 что у цифровых клавиш дайлпада. -->
            <Style x:Key="CallRoundBtn" TargetType="Button">
                <Setter Property="Width" Value="64" />
                <Setter Property="Height" Value="64" />
                <Setter Property="CornerRadius" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <!-- Пузыри чата -->
            <DataTemplate x:Key="ChatMineTemplate">
                <Border HorizontalAlignment="Right" Background="#0078D7" CornerRadius="10,10,2,10"
                        Padding="10,6" Margin="40,3,0,3" MaxWidth="300">
                    <TextBlock Text="{Binding Text}" Foreground="White" TextWrapping="Wrap" />
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="ChatTheirTemplate">
                <Border HorizontalAlignment="Left" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="10,10,10,2" Padding="10,6" Margin="0,3,40,3" MaxWidth="300"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                </Border>
            </DataTemplate>
            <local:ChatBubbleSelector x:Key="ChatBubbleSelector"
                                      Mine="{StaticResource ChatMineTemplate}"
                                      Their="{StaticResource ChatTheirTemplate}" />

            <!-- Звезда «избранное»: заполнена, если номер уже в избранном -->
            <local:FavoriteGlyphConverter x:Key="FavGlyph" />
            <local:BoolToVisibilityConverter x:Key="BoolVis" />
            <local:NotBoolConverter x:Key="NotBool" />
            <vm:PresenceBrushConverter x:Key="PresenceBrush" />

            <!-- Контекстное меню плитки BLF-пульта: позвонить/перехватить/написать/копировать/убрать -->
            <MenuFlyout x:Key="BlfMenu">
                <MenuFlyoutItem local:Tr.Key="RowCall.Text" Text="Позвонить" Click="OnRowMenuCall">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE717;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem local:Tr.Key="RowPickup.Text" Text="Перехватить" Click="OnBlfPickup"
                                Visibility="{Binding CanPickup, Converter={StaticResource BoolVis}}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9A1;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem local:Tr.Key="RowChat.Text" Text="Написать" Click="OnRowMenuChat">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8BD;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem local:Tr.Key="RowCopy.Text" Text="Копировать номер" Click="OnRowMenuCopy">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem local:Tr.Key="RowFav.Text" Text="В избранное / убрать" Click="OnRowMenuFav">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE734;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>

            <!-- Контекстное меню строки (контакт/избранное/журнал): правый клик / долгое нажатие.
                 DataContext строки наследуется пунктами — обработчики читают его. -->
            <MenuFlyout x:Key="RowMenu">
                <MenuFlyoutItem local:Tr.Key="RowCall.Text" Text="Позвонить" Click="OnRowMenuCall">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE717;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem local:Tr.Key="RowChat.Text" Text="Написать" Click="OnRowMenuChat">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8BD;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem local:Tr.Key="RowCopy.Text" Text="Копировать номер" Click="OnRowMenuCopy">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem local:Tr.Key="RowFav.Text" Text="В избранное / убрать" Click="OnRowMenuFav">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE734;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Шапка ============ -->
        <Grid Grid.Row="0" Background="{StaticResource LpBrandBrush}" Padding="14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center" Padding="0"
                    Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Мой статус">
                <Grid Width="40" Height="40">
                    <Ellipse Fill="{StaticResource LpAvatarFillBrush}" />
                    <TextBlock x:Name="AvatarInitials" Text="{x:Bind HeaderVm.AvatarInitials, Mode=OneWay}"
                               Foreground="{StaticResource LpBrandBrush}"
                               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <!-- Единственная точка статуса (внизу справа): цвет = presence-статус. -->
                    <Ellipse x:Name="RegDot" Width="12" Height="12" Fill="Gray" Stroke="{StaticResource LpBrandBrush}" StrokeThickness="2"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Grid>
                <Button.Flyout>
                    <MenuFlyout x:Name="StatusFlyout" />
                </Button.Flyout>
            </Button>

            <Button x:Name="AccountSwitcher" Grid.Column="1" Margin="6,0" Padding="6,2" VerticalAlignment="Center"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Переключить аккаунт">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="AccountNameText" Text="{x:Bind HeaderVm.AccountName, Mode=OneWay}" Foreground="White"
                                   FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="RegStatusText" Text="{x:Bind HeaderVm.StatusText, Mode=OneWay}"
                                   Foreground="{StaticResource LpSlateMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <FontIcon x:Name="AccountChevron" Grid.Column="1" Glyph="&#xE70D;" FontSize="12" Foreground="White"
                              Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
                <Button.Flyout>
                    <MenuFlyout x:Name="AccountFlyout" Placement="Bottom" />
                </Button.Flyout>
            </Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- MWI: новые сообщения голосовой почты; клик набирает номер прослушивания (*97). -->
                <Button x:Name="VoicemailBadge" Visibility="{x:Bind VisIf(HeaderVm.VoicemailWaiting), Mode=OneWay}"
                        Background="#0F6CBD" CornerRadius="10" Padding="8,3" BorderThickness="0"
                        VerticalAlignment="Center" Click="OnVoicemailBadgeClick">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE715;" Foreground="White" FontSize="12" />
                        <TextBlock Text="{x:Bind HeaderVm.VoicemailText, Mode=OneWay}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Border x:Name="MuteBadge" Visibility="{x:Bind VisIf(HeaderVm.Muted), Mode=OneWay}" Background="#C42B1C" CornerRadius="10"
                        Padding="8,3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE74F;" Foreground="White" FontSize="12" />
                        <TextBlock local:Tr.Key="BadgeMuted.Text" Text="Без звука" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border x:Name="DndBadge" Visibility="{x:Bind VisIf(HeaderVm.DndActive), Mode=OneWay}" Background="#C42B1C" CornerRadius="10"
                        Padding="8,3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE7ED;" Foreground="White" FontSize="12" />
                        <TextBlock local:Tr.Key="BadgeDnd.Text" Text="DND" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border x:Name="AutoAnswerBadge" Visibility="{x:Bind VisIf(HeaderVm.AutoAnswerActive), Mode=OneWay}" Background="#2BA84A" CornerRadius="10"
                        Padding="8,3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE717;" Foreground="White" FontSize="12" />
                        <TextBlock local:Tr.Key="BadgeAuto.Text" Text="Автоответ" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Button Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                    ToolTipService.ToolTip="Меню">
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom" Opening="OnMainMenuOpening">
                        <MenuFlyoutItem x:Name="MiAccount" Text="Мой аккаунт" Click="OnAccountClick">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77B;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <ToggleMenuFlyoutItem x:Name="MiDnd" Text="Не беспокоить" Click="OnDndMenuToggled">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7ED;" /></MenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="MiSettings" Text="Настройки" Click="OnSettingsClick">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MiAbout" Text="О программе" Click="OnAboutClick">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="MiExit" Text="Выйти из приложения" Click="OnExitClick">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7E8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
                <FontIcon Glyph="&#xE713;" Foreground="White" FontSize="18" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ Контент ============ -->
        <Grid Grid.Row="1">

            <!-- Секция: Набор -->
            <ScrollViewer x:Name="DialerSection" Padding="12,12" VerticalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10" HorizontalAlignment="Stretch">

                    <!-- Верхняя зона ФИКСИРОВАННОЙ высоты: набор / входящий / активный звонок
                         показываются в одном и том же месте, поэтому циферблат ниже не двигается. -->
                    <Grid x:Name="TopZone" Height="150">

                        <!-- Набор: серое окошко номера + имя из адресной книги -->
                        <StackPanel x:Name="DialerTop" VerticalAlignment="Center">
                            <!-- Цвета — токены Lp* из App.xaml: светлая тема повторяет прежний вид
                                 (LightGray/DimGray), тёмная — iOS-палитру (тёмная плашка, белый номер). -->
                            <Border x:Name="NumberDisplay" CornerRadius="8" Padding="14,8" MaxWidth="280"
                                    Background="{ThemeResource LpNumberFillBrush}"
                                    BorderBrush="{ThemeResource LpNumberStrokeBrush}"
                                    BorderThickness="1" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NumberBox" Grid.Column="0" FontSize="24" TextAlignment="Left"
                                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                             Foreground="{ThemeResource LpNumberTextBrush}"
                                             Text="{x:Bind DialerVm.Number, Mode=TwoWay}"
                                             KeyDown="OnNumberBoxKeyDown" />
                                    <Button x:Name="BackspaceButton" Grid.Column="1" Width="34" Height="34" CornerRadius="17"
                                            Padding="0" BorderThickness="0" VerticalAlignment="Center"
                                            Visibility="{x:Bind VisIf(DialerVm.HasNumber), Mode=OneWay}"
                                            Background="{ThemeResource LpNumberFillBrush}"
                                            Foreground="{ThemeResource LpBackspaceTextBrush}" Click="OnBackspaceClick">
                                        <TextBlock Text="&#x232B;" FontSize="14" />
                                    </Button>
                                </Grid>
                            </Border>
                            <!-- Имя из адресной книги: место зарезервировано всегда (не дёргает интерфейс). -->
                            <TextBlock x:Name="MatchedContactText" Height="22" HorizontalAlignment="Center"
                                       Margin="0,8,0,0" FontSize="15" FontWeight="SemiBold"
                                       Text="{x:Bind DialerVm.MatchedName, Mode=OneWay}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextAlignment="Center" />
                        </StackPanel>

                    </Grid>

                    <!-- Сетка набора «а-ля iPhone»: круглые клавиши фиксированного размера,
                         зазоры фиксированные и НЕ зависят от ширины окна.
                         Хочешь шире/уже — меняй ColumnSpacing/RowSpacing. -->
                    <Grid x:Name="Dialpad" RowSpacing="12" ColumnSpacing="24" HorizontalAlignment="Center">
                        <Grid.Resources>
                            <!-- Круглые клавиши: iOS-палитра по темам ("Default" = тёмная).
                                 Цвет цифр одинаковый во всех состояниях, фон чуть темнеет при
                                 наведении/нажатии — как подсветка клавиш в iOS. -->
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="ButtonBackground" Color="#E9E9EB" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#DEDEE0" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#C7C7CC" />
                                        <SolidColorBrush x:Key="ButtonForeground" Color="#111111" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#111111" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#111111" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Default">
                                        <SolidColorBrush x:Key="ButtonBackground" Color="#2C2C2E" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#38383A" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#48484A" />
                                        <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource DialKey}" Tag="1" Click="OnDigitClick">
                            <StackPanel Spacing="0">
                                <TextBlock Text="1" FontSize="32" HorizontalAlignment="Center" />
                                <TextBlock Text="" FontSize="9" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource DialKey}" Tag="2" Click="OnDigitClick">
                            <StackPanel Spacing="0">
                                <TextBlock Text="2" FontSize="32" HorizontalAlignment="Center" />
                                <TextBlock Text="ABC" FontSize="9" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource DialKey}" Tag="3" Click="OnDigitClick">
                            <StackPanel Spacing="0">
                                <TextBlock Text="3" FontSize="32" HorizontalAlignment="Center" />
                                <TextBlock Text="DEF" FontSize="9" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource DialKey}" Tag="4" Click="OnDigitClick">
                            <StackPanel Spacing="0">
                                <TextBlock Text="4" FontSize="32" HorizontalAlignment="Center" />
                                <TextBlock Text="GHI" FontSize="9" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource DialKey}" Tag="5" Click="OnDigitClick">
                            <StackPanel Spacing="0">
                                <TextBlock Text="5" FontSize="32" HorizontalAlignment="Center" />
                                <TextBlock Text="JKL" FontSize="9" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource DialKey}" Tag="6" Click="OnDigitClick">
                            <StackPanel Spacing="0">
                                <TextBlock Text="6" FontSize="32" HorizontalAlignment="Center" />
                                <TextBlock Text="MNO" FontSize="9" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource DialKey}" Tag="7" Click="OnDigitClick">
                            <StackPanel Spacing="0">
                                <TextBlock Text="7" FontSize="32" HorizontalAlignment="Center" />
                                <TextBlock Text="PQRS" FontSize="9" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource DialKey}" Tag="8" Click="OnDigitClick">
                            <StackPanel Spacing="0">
                                <TextBlock Text="8" FontSize="32" HorizontalAlignment="Center" />
                                <TextBlock Text="TUV" FontSize="9" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource DialKey}" Tag="9" Click="OnDigitClick">
                            <StackPanel Spacing="0">
                                <TextBlock Text="9" FontSize="32" HorizontalAlignment="Center" />
                                <TextBlock Text="WXYZ" FontSize="9" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource DialKey}" Tag="*" Click="OnDigitClick">
                            <StackPanel Spacing="0">
                                <TextBlock Text="&#x2217;" FontSize="32" HorizontalAlignment="Center" />
                                <TextBlock Text=" " FontSize="9" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource DialKey}" Tag="0" Click="OnDigitClick">
                            <StackPanel Spacing="-6">
                                <TextBlock Text="0" FontSize="32" HorizontalAlignment="Center" />
                                <TextBlock Text="" FontSize="9" Foreground="Gray" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource DialKey}" Tag="#" Click="OnDigitClick">
                            <StackPanel Spacing="0">
                                <TextBlock Text="#" FontSize="32" HorizontalAlignment="Center" />
                                <TextBlock Text=" " FontSize="9" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Набор: зелёная кнопка вызова по центру -->
                    <StackPanel x:Name="DialActions" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <!-- Сетка как у клавиатуры: зелёная под «0», повтор последнего — под «#» -->
                        <Grid HorizontalAlignment="Center" ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CallButton" Grid.Column="1" Width="64" Height="64" CornerRadius="32"
                                Background="#2BA84A" HorizontalAlignment="Center" Click="OnCallClick">
                                <Button.Resources>
                                    <!-- при наведении -->
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#249A43" />
                                    <!-- при нажатии -->
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#18662c" />
                                </Button.Resources>
                                <FontIcon Glyph="&#xE717;" Foreground="White" FontSize="26" />
                            </Button>
                            <!-- Повтор последнего набранного (паритет с Android): подставляет номер
                                 в поле. Нечего повторять — кнопки нет (в Android так же), иначе клик
                                 был бы молчаливым «ничего не произошло». Тултип и имя для screen
                                 reader ставит ApplyLocalization/ApplyAutomationNames — приложение
                                 переводится на три языка, хардкод текста здесь недопустим.
                                 Стиль DialKey + кисти клавиатуры: кнопка стоит в ряду циферблата и
                                 не должна выпадать из него рамкой и фоном по умолчанию. -->
                            <Button x:Name="LastDialedButton" Grid.Column="2" Style="{StaticResource DialKey}"
                                Width="48" Height="48" CornerRadius="24"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{x:Bind VisIf(DialerVm.HasLastDialed), Mode=OneWay}"
                                Click="OnLastDialedClick">
                                <Button.Resources>
                                    <ResourceDictionary>
                                        <ResourceDictionary.ThemeDictionaries>
                                            <ResourceDictionary x:Key="Light">
                                                <SolidColorBrush x:Key="ButtonBackground" Color="#E9E9EB" />
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#DEDEE0" />
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#C7C7CC" />
                                                <SolidColorBrush x:Key="ButtonForeground" Color="#111111" />
                                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#111111" />
                                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#111111" />
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="Default">
                                                <SolidColorBrush x:Key="ButtonBackground" Color="#2C2C2E" />
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#38383A" />
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#48484A" />
                                                <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
                                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                                            </ResourceDictionary>
                                        </ResourceDictionary.ThemeDictionaries>
                                    </ResourceDictionary>
                                </Button.Resources>
                                <FontIcon Glyph="&#xE72C;" FontSize="18" />
                            </Button>
                        </Grid>
                        <!-- Причина неудавшегося звонка (Занято/Нет ответа/…), гаснет по таймеру -->
                        <TextBlock x:Name="CallEndReasonText" Visibility="Collapsed" Margin="0,10,0,0"
                                   HorizontalAlignment="Center" FontSize="13"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <!-- Автодозвон: обратный отсчёт до повторного набора + отмена -->
                        <StackPanel x:Name="RedialPanel" Visibility="Collapsed" Margin="0,10,0,0"
                                    HorizontalAlignment="Center" Spacing="6">
                            <TextBlock x:Name="RedialText" HorizontalAlignment="Center" FontSize="13" />
                            <Button x:Name="RedialCancelButton" local:Tr.Key="BtnRedialCancel.Content"
                                    Content="Отменить автодозвон" HorizontalAlignment="Center"
                                    Click="OnRedialCancelClick" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>


            <!-- Секция: Активный звонок (полноэкранный, а-ля iPhone).
                 Показывается на вкладке «Набор» вместо дайлера, пока идёт разговор. -->
            <Grid x:Name="InCallSection" Visibility="Collapsed" Padding="12,12">
                <Grid.Resources>
                    <!-- Кнопки звонка в тех же цветах, что цифровые клавиши дайлпада -->
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="ButtonBackground" Color="#E9E9EB" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#DEDEE0" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#C7C7CC" />
                                <SolidColorBrush x:Key="ButtonForeground" Color="#111111" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#111111" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#111111" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Default">
                                <SolidColorBrush x:Key="ButtonBackground" Color="#2C2C2E" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#38383A" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#48484A" />
                                <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Имя, статус/таймер, DTMF и (при видеозвонке) область видео.
                     Аудио: тексты по центру (CallTopArea=Center, видео скрыто).
                     Видео: тексты сверху, ниже — VideoSurface (растянут; переключает
                     UpdateVideoLayout в code-behind). -->
                <Grid x:Name="CallTopArea" Grid.Row="0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="CallTexts" Grid.Row="0" Spacing="2">
                        <TextBlock x:Name="RemoteText" FontSize="28" FontWeight="SemiBold"
                                   Text="{x:Bind CallVm.RemoteName, Mode=OneWay}"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="CallStatusText" FontSize="15" Opacity="0.6" TextAlignment="Center"
                                   Text="{x:Bind CallVm.StatusText, Mode=OneWay}" />
                        <TextBlock x:Name="DtmfDots" FontSize="17" FontWeight="SemiBold" CharacterSpacing="120"
                                   Text="{x:Bind CallVm.DtmfText, Mode=OneWay}"
                                   Height="24" TextAlignment="Center" />
                    </StackPanel>
                    <!-- Видео собеседника + превью своей камеры в углу. Рендерит liblinphone
                         в child-HWND (VideoWindowHost) ПОВЕРХ этой области — XAML-оверлеи
                         сюда класть нельзя (airspace). Границы задают эти плейсхолдеры. -->
                    <Grid x:Name="VideoArea" Grid.Row="1" Visibility="Collapsed" MinHeight="160" Margin="0,10,0,0">
                        <Border x:Name="VideoSurface" Background="Black" />
                        <Border x:Name="PreviewSurface" Width="128" Height="72"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" />
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                    <!-- Сетка управления звонком -->
                    <Grid x:Name="InCallButtons" ColumnSpacing="26" RowSpacing="10" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <!-- MinHeight резервирует место контекстных кнопок (Переключить/Пригласить):
                                 когда они скрываются, нижние ряды НЕ подтягиваются вверх. -->
                            <RowDefinition Height="Auto" MinHeight="86" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="76" />
                            <ColumnDefinition Width="Auto" MinWidth="76" />
                            <ColumnDefinition Width="Auto" MinWidth="76" />
                        </Grid.ColumnDefinitions>

                        <!-- Ряд 1: контекстно «Переключить» в центре, Запись справа -->
                        <StackPanel x:Name="SwapStack" Grid.Row="0" Grid.Column="1" Spacing="4" Visibility="Collapsed">
                            <Button x:Name="SwapButton" Style="{StaticResource CallRoundBtn}" Click="OnSwapClick">
                                <FontIcon Glyph="&#xE895;" FontSize="22" />
                            </Button>
                            <TextBlock local:Tr.Key="LblSwap.Text" Text="Переключить" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="ConferenceStack" Grid.Row="0" Grid.Column="2" Spacing="4" Visibility="Collapsed">
                            <Button x:Name="ConferenceButton" Style="{StaticResource CallRoundBtn}" Click="OnConferenceClick">
                                <FontIcon Glyph="&#xE716;" FontSize="22" />
                            </Button>
                            <TextBlock x:Name="ConferenceLabel" local:Tr.Key="LblInvite.Text" Text="Пригласить" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Ряд 2: Микрофон, Клавиши, Видео -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <Button x:Name="MuteButton" Style="{StaticResource CallRoundBtn}" IsEnabled="False" Click="OnMuteClick">
                                <FontIcon x:Name="MuteIcon" Glyph="&#xE720;" FontSize="22" />
                            </Button>
                            <TextBlock x:Name="MuteLabel" local:Tr.Key="LblMic.Text" Text="Микрофон" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="KeypadStack" Grid.Row="1" Grid.Column="1" Spacing="4">
                            <Button x:Name="KeypadButton" Style="{StaticResource CallRoundBtn}" Click="OnKeypadToggleClick">
                                <FontIcon Glyph="&#xE75F;" FontSize="22" />
                            </Button>
                            <TextBlock local:Tr.Key="LblKeypad.Text" Text="Клавиши" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="VideoStack" Grid.Row="1" Grid.Column="2" Spacing="4">
                            <Button x:Name="VideoButton" Style="{StaticResource CallRoundBtn}" IsEnabled="False" Click="OnVideoClick">
                                <FontIcon Glyph="&#xE714;" FontSize="22" />
                            </Button>
                            <TextBlock local:Tr.Key="LblVideo.Text" Text="Видео" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Ряд 3: Запись, Удержание, Перевод -->
                        <StackPanel x:Name="RecordStack" Grid.Row="2" Grid.Column="0" Spacing="4">
                            <Button x:Name="RecordButton" Style="{StaticResource CallRoundBtn}" IsEnabled="False" Click="OnRecordClick">
                                <Ellipse x:Name="RecordDot" Width="18" Height="18" Fill="Gray" />
                            </Button>
                            <TextBlock x:Name="RecordLabel" local:Tr.Key="LblRecord.Text" Text="Запись" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="HoldStack" Grid.Row="2" Grid.Column="1" Spacing="4">
                            <Button x:Name="HoldButton" Style="{StaticResource CallRoundBtn}" IsEnabled="False" Click="OnHoldClick">
                                <FontIcon Glyph="&#xE769;" FontSize="22" />
                            </Button>
                            <TextBlock x:Name="HoldLabel" local:Tr.Key="LblHold.Text" Text="Удержание" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="TransferStack" Grid.Row="2" Grid.Column="2" Spacing="4">
                            <Button x:Name="TransferButton" Style="{StaticResource CallRoundBtn}" IsEnabled="False" Click="OnTransferClick">
                                <FontIcon Glyph="&#xE8AB;" FontSize="22" />
                            </Button>
                            <TextBlock local:Tr.Key="LblTransfer.Text" Text="Перевод" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- DTMF-клавиатура (по кнопке «Клавиши»): цифры уходят тонами в разговор -->
                    <StackPanel x:Name="InCallKeypad" Visibility="Collapsed" HorizontalAlignment="Center">
                        <Grid ColumnSpacing="26" RowSpacing="10" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource CallRoundBtn}" Tag="1" Click="OnDigitClick"><TextBlock Text="1" FontSize="24" /></Button>
                            <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource CallRoundBtn}" Tag="2" Click="OnDigitClick"><TextBlock Text="2" FontSize="24" /></Button>
                            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource CallRoundBtn}" Tag="3" Click="OnDigitClick"><TextBlock Text="3" FontSize="24" /></Button>
                            <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource CallRoundBtn}" Tag="4" Click="OnDigitClick"><TextBlock Text="4" FontSize="24" /></Button>
                            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CallRoundBtn}" Tag="5" Click="OnDigitClick"><TextBlock Text="5" FontSize="24" /></Button>
                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource CallRoundBtn}" Tag="6" Click="OnDigitClick"><TextBlock Text="6" FontSize="24" /></Button>
                            <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource CallRoundBtn}" Tag="7" Click="OnDigitClick"><TextBlock Text="7" FontSize="24" /></Button>
                            <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource CallRoundBtn}" Tag="8" Click="OnDigitClick"><TextBlock Text="8" FontSize="24" /></Button>
                            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource CallRoundBtn}" Tag="9" Click="OnDigitClick"><TextBlock Text="9" FontSize="24" /></Button>
                            <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource CallRoundBtn}" Tag="*" Click="OnDigitClick"><TextBlock Text="&#x2217;" FontSize="24" /></Button>
                            <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource CallRoundBtn}" Tag="0" Click="OnDigitClick"><TextBlock Text="0" FontSize="24" /></Button>
                            <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource CallRoundBtn}" Tag="#" Click="OnDigitClick"><TextBlock Text="#" FontSize="24" /></Button>
                        </Grid>
                        <Button x:Name="HideKeypadButton" local:Tr.Key="BtnHideKeypad.Content" Content="Скрыть"
                                Background="Transparent" BorderThickness="0" HorizontalAlignment="Center"
                                Margin="0,10,0,0" Click="OnKeypadToggleClick" />
                    </StackPanel>
                </StackPanel>

                <!-- Нижний ряд. Аудио: одна красная кнопка (сетка управления выше).
                     Видео: микрофон и видео по бокам от красной (VideoControls). -->
                <Grid Grid.Row="3" HorizontalAlignment="Center" Margin="0,10,0,18" ColumnSpacing="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="VideoMuteStack" Grid.Column="0" Spacing="4" Visibility="Collapsed"
                                VerticalAlignment="Center">
                        <Button x:Name="VideoMuteButton" Style="{StaticResource CallRoundBtn}" Click="OnMuteClick">
                            <FontIcon x:Name="VideoMuteIcon" Glyph="&#xE720;" FontSize="22" />
                        </Button>
                        <TextBlock x:Name="VideoMuteLabel" local:Tr.Key="LblMic.Text" Text="Микрофон"
                                   FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Button x:Name="HangupButton" Grid.Column="1" Width="64" Height="64" CornerRadius="32" Padding="0"
                            BorderThickness="0" Background="#FF3B30" VerticalAlignment="Center"
                            Click="OnHangupClick">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E33529" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#C42B1C" />
                        </Button.Resources>
                        <FontIcon Glyph="&#xE778;" Foreground="White" FontSize="24" />
                    </Button>

                    <StackPanel x:Name="VideoCamStack" Grid.Column="2" Spacing="4" Visibility="Collapsed"
                                VerticalAlignment="Center">
                        <Button x:Name="VideoCamButton" Style="{StaticResource CallRoundBtn}" Click="OnVideoClick">
                            <FontIcon Glyph="&#xE714;" FontSize="22" />
                        </Button>
                        <TextBlock local:Tr.Key="LblVideo.Text" Text="Видео" FontSize="11" Opacity="0.7"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Секция: Входящий звонок (полноэкранный, а-ля iPhone): имя вверху,
                 круглые цветные кнопки принять/отклонить внизу. -->
            <Grid x:Name="IncomingSection" Visibility="Collapsed" Padding="12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="6" HorizontalAlignment="Center">
                    <Border Width="84" Height="84" CornerRadius="42" Background="{StaticResource LpBrandBrush}" HorizontalAlignment="Center">
                        <TextBlock x:Name="IncomingAvatar" Foreground="White" FontSize="30" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock local:Tr.Key="IncomingCall.Text" Text="Входящий звонок" FontSize="14" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock x:Name="IncomingName" FontSize="26" FontWeight="SemiBold" TextAlignment="Center"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="IncomingNumber" FontSize="15" Opacity="0.6" TextAlignment="Center" HorizontalAlignment="Center" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,24" HorizontalAlignment="Center" ColumnSpacing="72">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="6">
                        <Button Width="68" Height="68" CornerRadius="34" Padding="0" BorderThickness="0"
                                Background="#C42B1C" HorizontalAlignment="Center" Click="OnDeclineClick"
                                AutomationProperties.Name="Отклонить">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#B02418" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#8E1D13" />
                            </Button.Resources>
                            <FontIcon Glyph="&#xE778;" Foreground="White" FontSize="26" />
                        </Button>
                        <TextBlock local:Tr.Key="BtnDecline.Content" Text="Отклонить" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <Button Width="68" Height="68" CornerRadius="34" Padding="0" BorderThickness="0"
                                Background="#2BA84A" HorizontalAlignment="Center" Click="OnAcceptClick"
                                AutomationProperties.Name="Принять">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#249A43" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#18662C" />
                            </Button.Resources>
                            <FontIcon Glyph="&#xE717;" Foreground="White" FontSize="26" />
                        </Button>
                        <TextBlock local:Tr.Key="BtnAccept.Content" Text="Принять" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Секция: Контакты (внешняя адресная книга) -->
            <Grid x:Name="ContactsSection" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="8,8,8,4" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="ContactsSearch" local:Tr.Key="ContactsSearchBox.PlaceholderText" Grid.Column="0"
                                    PlaceholderText="Поиск по имени или номеру" QueryIcon="Find"
                                    TextChanged="OnContactsSearchChanged" />
                    <Button x:Name="AddContactButton" Grid.Column="1" Click="OnAddContactClick"
                            ToolTipService.ToolTip="Добавить контакт" VerticalAlignment="Stretch">
                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                    </Button>
                </Grid>
                <ListView x:Name="ContactsList" Grid.Row="1" SelectionMode="None" ItemsSource="{x:Bind ContactsVm.Contacts}"
                          IsItemClickEnabled="True" ItemClick="OnContactItemClick" Padding="6">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,6" ColumnSpacing="8" ContextFlyout="{StaticResource RowMenu}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                        Background="{StaticResource LpBrandBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14" />
                                    <TextBlock Text="{Binding SubText}" Foreground="Gray" FontSize="12" />
                                </StackPanel>
                                <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="8"
                                        VerticalAlignment="Center" Click="OnRowCallClick"
                                        ToolTipService.ToolTip="Позвонить">
                                    <FontIcon FontSize="16" Foreground="#2BA84A" Glyph="&#xE717;" />
                                </Button>
                                <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="8"
                                        VerticalAlignment="Center" Click="OnEditContactClick"
                                        Visibility="{Binding IsLocal, Converter={StaticResource BoolVis}}"
                                        ToolTipService.ToolTip="Изменить">
                                    <FontIcon FontSize="15" Glyph="&#xE70F;" />
                                </Button>
                                <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="8"
                                        VerticalAlignment="Center" Click="OnContactFavToggle"
                                        ToolTipService.ToolTip="В избранное">
                                    <FontIcon FontSize="16" Foreground="#E8A200"
                                              Glyph="{Binding CallNumber, Converter={StaticResource FavGlyph}}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="ContactsEmpty" local:Tr.Key="ContactsEmptyText.Text" Grid.Row="1" Text="Ничего не найдено"
                           Foreground="Gray" FontSize="13"
                           Visibility="{x:Bind VisIf(ContactsVm.IsEmpty), Mode=OneWay}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock x:Name="ContactsStatus" Grid.Row="2" Foreground="Gray" FontSize="12"
                           Text="{x:Bind ContactsVm.StatusText, Mode=OneWay}"
                           Margin="10,4,10,8" TextWrapping="Wrap" />
            </Grid>

            <!-- Секция: Избранное (локальные пометки) -->
            <Grid x:Name="FavoritesSection" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Переключатель вида: список ↔ BLF-пульт (сетка коллег со статусом занятости) -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="0"
                            Margin="0,4,10,2">
                    <ToggleButton x:Name="FavListViewBtn" Padding="8,4" Click="OnFavViewListClick"
                                  IsChecked="{x:Bind NotVal(FavoritesVm.GridView), Mode=OneWay}"
                                  ToolTipService.ToolTip="Список">
                        <FontIcon Glyph="&#xE8FD;" FontSize="15" />
                    </ToggleButton>
                    <ToggleButton x:Name="FavGridViewBtn" Padding="8,4" Click="OnFavViewGridClick"
                                  IsChecked="{x:Bind FavoritesVm.GridView, Mode=OneWay}"
                                  ToolTipService.ToolTip="Пульт (BLF)">
                        <FontIcon Glyph="&#xE80A;" FontSize="15" />
                    </ToggleButton>
                </StackPanel>

                <!-- BLF-пульт: плитки коллег, крупный кружок статуса; клик — звонок, ПКМ — меню -->
                <GridView x:Name="BlfGrid" Grid.Row="1" Padding="8" SelectionMode="None"
                          Visibility="{x:Bind VisIf(FavoritesVm.GridView), Mode=OneWay}"
                          ItemsSource="{x:Bind FavoritesVm.Favorites}"
                          IsItemClickEnabled="True" ItemClick="OnFavoriteItemClick">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="104" Height="96" Padding="4" RowSpacing="3"
                                  ContextFlyout="{StaticResource BlfMenu}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Width="46" Height="46" HorizontalAlignment="Center">
                                    <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource LpBrandBrush}">
                                        <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="15"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <!-- Лампа занятости: цвет по presence-статусу -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"
                                            Width="15" Height="15" CornerRadius="8"
                                            BorderBrush="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderThickness="2"
                                            Background="{Binding Status, Converter={StaticResource PresenceBrush}}" />
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding Display}" FontSize="12" TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <TextBlock Grid.Row="2" Text="{Binding Number}" FontSize="10" Opacity="0.6"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="3" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>

                <ListView x:Name="FavoritesList" Grid.Row="1" SelectionMode="None" ItemsSource="{x:Bind FavoritesVm.Favorites}"
                          Visibility="{x:Bind VisIfNot(FavoritesVm.GridView), Mode=OneWay}"
                          IsItemClickEnabled="True" ItemClick="OnFavoriteItemClick" Padding="6">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,6" ColumnSpacing="12" ContextFlyout="{StaticResource RowMenu}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="38" Height="38" VerticalAlignment="Center">
                                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource LpBrandBrush}">
                                        <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <!-- Эмодзи статуса присутствия -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                            CornerRadius="9" Width="18" Height="18" Margin="0,0,-2,-2">
                                        <TextBlock Text="{Binding StatusEmojiText}" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Display}" FontSize="14" />
                                    <TextBlock Text="{Binding SubText}" Foreground="Gray" FontSize="12" />
                                </StackPanel>
                                <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="8"
                                        VerticalAlignment="Center" Click="OnRowCallClick"
                                        ToolTipService.ToolTip="Позвонить">
                                    <FontIcon FontSize="16" Foreground="#2BA84A" Glyph="&#xE717;" />
                                </Button>
                                <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="8"
                                        VerticalAlignment="Center" Click="OnFavoriteRemove"
                                        ToolTipService.ToolTip="Убрать из избранного">
                                    <FontIcon FontSize="16" Foreground="#E8A200"
                                              Glyph="{Binding Number, Converter={StaticResource FavGlyph}}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="FavoritesEmpty" Grid.Row="1" local:Tr.Key="FavoritesEmptyText.Text" Text="В избранном пусто"
                           Foreground="Gray" FontSize="13"
                           Visibility="{x:Bind VisIf(FavoritesVm.IsEmpty), Mode=OneWay}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- Секция: Журнал -->
            <Grid x:Name="HistorySection" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView x:Name="HistoryList" Grid.Row="0" SelectionMode="None" ItemsSource="{x:Bind HistoryVm.Entries}"
                          IsItemClickEnabled="True" ItemClick="OnHistoryItemClick" Padding="6">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="6,8" ColumnSpacing="8" ContextFlyout="{StaticResource RowMenu}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="15" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="Gray" />
                                </StackPanel>
                                <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="8"
                                        VerticalAlignment="Center" Click="OnRowCallClick"
                                        ToolTipService.ToolTip="Позвонить">
                                    <FontIcon FontSize="16" Foreground="#2BA84A" Glyph="&#xE717;" />
                                </Button>
                                <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="8"
                                        VerticalAlignment="Center" Click="OnHistoryFavToggle"
                                        ToolTipService.ToolTip="В избранное">
                                    <FontIcon FontSize="16" Foreground="#E8A200"
                                              Glyph="{Binding Remote, Converter={StaticResource FavGlyph}}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="HistoryEmpty" local:Tr.Key="HistoryEmptyText.Text" Grid.Row="0" Text="Журнал пуст" Foreground="Gray"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{x:Bind VisIf(HistoryVm.IsEmpty), Mode=OneWay}" />
                <Button local:Tr.Key="BtnClearHistory.Content" Grid.Row="1" Content="Очистить журнал" Margin="8" HorizontalAlignment="Center"
                        Click="OnClearHistoryClick" />
            </Grid>

            <!-- Секция: Чат (SIP MESSAGE) -->
            <Grid x:Name="ChatSection" Visibility="Collapsed">

                <!-- Список переписок -->
                <Grid x:Name="ChatListView" Visibility="{x:Bind VisIf(ChatVm.IsListView), Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView x:Name="ConversationsList" Grid.Row="0" SelectionMode="None" ItemsSource="{x:Bind ChatVm.Conversations}"
                              IsItemClickEnabled="True" ItemClick="OnConversationClick" Padding="6">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,8" ColumnSpacing="12">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem local:Tr.Key="RowDeleteChat.Text" Text="Удалить переписку"
                                                            Click="OnConversationDeleteClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                            Background="{StaticResource LpBrandBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="Gray"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#C42B1C" CornerRadius="10" MinWidth="20" Height="20"
                                            Padding="5,0" VerticalAlignment="Center" Visibility="{Binding HasUnread}">
                                        <TextBlock Text="{Binding UnreadText}" Foreground="White" FontSize="11"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="ConversationsEmpty" local:Tr.Key="ChatEmptyText.Text" Grid.Row="0"
                               Text="Нет переписок" Foreground="Gray" FontSize="13"
                               Visibility="{x:Bind VisIf(ChatVm.ConversationsEmpty), Mode=OneWay}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Grid Grid.Row="1" Margin="8,4,8,8" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewChatPeerBox" local:Tr.Key="ChatNewPeer.PlaceholderText" Grid.Column="0"
                                 PlaceholderText="Новый чат: номер или SIP-адрес" />
                        <Button x:Name="NewChatButton" Grid.Column="1" Click="OnStartNewChatClick"
                                ToolTipService.ToolTip="Открыть чат">
                            <FontIcon Glyph="&#xE8BD;" FontSize="16" />
                        </Button>
                    </Grid>
                </Grid>

                <!-- Переписка -->
                <Grid x:Name="ChatConversationView" Visibility="{x:Bind VisIfNot(ChatVm.IsListView), Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="4,6,8,4" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ChatBackButton" Grid.Column="0" Click="OnChatBackClick"
                                Background="Transparent" BorderThickness="0" Padding="8"
                                ToolTipService.ToolTip="К списку">
                            <FontIcon Glyph="&#xE72B;" FontSize="16" />
                        </Button>
                        <TextBlock x:Name="ChatHeader" Grid.Column="1" VerticalAlignment="Center" FontSize="15"
                                   Text="{x:Bind ChatVm.ChatHeader, Mode=OneWay}"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ListView x:Name="ChatList" Grid.Row="1" SelectionMode="None" Padding="8,4"
                              ItemsSource="{x:Bind ChatVm.Messages}"
                              ItemTemplateSelector="{StaticResource ChatBubbleSelector}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    <Grid Grid.Row="2" Margin="8,4,8,8" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInput" local:Tr.Key="ChatInputBox.PlaceholderText" Grid.Column="0" PlaceholderText="Сообщение…"
                                 KeyDown="OnChatInputKeyDown" />
                        <Button x:Name="ChatSendButton" Grid.Column="1" Click="OnChatSendClick"
                                Style="{StaticResource AccentButtonStyle}">
                            <FontIcon Glyph="&#xE724;" FontSize="16" />
                        </Button>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Баннер ВТОРОГО входящего (во время разговора): поверх любой вкладки,
                 экран активного звонка остаётся видимым и управляемым. -->
            <Border x:Name="IncomingBanner" Visibility="Collapsed" VerticalAlignment="Top"
                    Margin="10,8" Padding="12,10" CornerRadius="10" Translation="0,0,32"
                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                    BorderBrush="{ThemeResource AccentControlElevationBorderBrush}" BorderThickness="1">
                <Border.Shadow><ThemeShadow /></Border.Shadow>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="IncomingBannerTitle" local:Tr.Key="IncomingCall.Text" Text="Входящий звонок"
                                   FontSize="12" Opacity="0.7" />
                        <TextBlock x:Name="IncomingBannerText" FontWeight="SemiBold" FontSize="14"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Width="40" Height="40" CornerRadius="20" Padding="0" BorderThickness="0"
                            Background="#2BA84A" Click="OnAcceptClick" ToolTipService.ToolTip="Принять">
                        <FontIcon Glyph="&#xE717;" Foreground="White" FontSize="16" />
                    </Button>
                    <Button Grid.Column="2" Width="40" Height="40" CornerRadius="20" Padding="0" BorderThickness="0"
                            Background="#C42B1C" Click="OnDeclineClick" ToolTipService.ToolTip="Отклонить">
                        <FontIcon Glyph="&#xE778;" Foreground="White" FontSize="16" />
                    </Button>
                </Grid>
            </Border>

        </Grid>

        <!-- ============ Низ: вкладки (видны всегда, в т.ч. во время звонка) ============ -->
        <StackPanel Grid.Row="2">

            <Grid x:Name="NavBar" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="0,2"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid.Resources>
                    <!-- Цвет цифр одинаковый во всех состояниях (иначе при наведении системный почти-чёрный) -->
                    <SolidColorBrush x:Key="ButtonForeground" Color="#4E6075" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#006075" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#4E6075" />
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="NavDial" Grid.Column="0" Style="{StaticResource NavTab}" Click="OnNavDialClick">
                    <StackPanel HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE717;" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock local:Tr.Key="NavDialText.Text" Text="Набор" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavContacts" Grid.Column="1" Style="{StaticResource NavTab}" Click="OnNavContactsClick">
                    <StackPanel HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE716;" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock local:Tr.Key="NavContactsText.Text" Text="Контакты" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavFavorites" Grid.Column="2" Style="{StaticResource NavTab}" Click="OnNavFavoritesClick">
                    <StackPanel HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE735;" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock local:Tr.Key="NavFavoritesText.Text" Text="Избранное" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavHistory" Grid.Column="3" Style="{StaticResource NavTab}" Click="OnNavHistoryClick">
                    <StackPanel HorizontalAlignment="Center">
                        <Grid HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE81C;" FontSize="18" HorizontalAlignment="Center" />
                            <Border x:Name="MissedBadge" Visibility="Collapsed" Background="#C42B1C" CornerRadius="8"
                                    MinWidth="16" Height="16" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-6,-12,0">
                                <TextBlock x:Name="MissedBadgeText" Text="0" Foreground="White" FontSize="10"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock local:Tr.Key="NavHistoryText.Text" Text="Журнал" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavChat" Grid.Column="4" Style="{StaticResource NavTab}" Click="OnNavChatClick">
                    <StackPanel HorizontalAlignment="Center">
                        <Grid HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8BD;" FontSize="18" HorizontalAlignment="Center" />
                            <Border x:Name="ChatBadge" Visibility="Collapsed" Background="#C42B1C" CornerRadius="8"
                                    MinWidth="16" Height="16" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-6,-12,0">
                                <TextBlock x:Name="ChatBadgeText" Text="0" Foreground="White" FontSize="10"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock local:Tr.Key="NavChatText.Text" Text="Чат" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Значок в системном трее (H.NotifyIcon). Иконка генерируется из текста «L». -->
        <tb:TaskbarIcon x:Name="TrayIcon" ToolTipText="L-Phone" NoLeftClickDelay="True"
                        IconSource="ms-appx:///Assets/lphone.ico">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="MiTrayOpen" Text="Открыть L-Phone" />
                    <MenuFlyoutItem x:Name="MiTrayExit" Text="Выйти" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
