<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LinphoneWinUI.MiniCallWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LinphoneWinUI">

    <!-- Мини-окно активного звонка: висит поверх всех окон, чтобы управлять разговором,
         не выискивая софтфон под CRM. Только то, что нужно в разговоре: кто на линии,
         сколько идёт, микрофон, удержание и сброс. Всё остальное — в главном окне. -->
    <Grid Padding="12,10" RowSpacing="8" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
            <Border Width="34" Height="34" CornerRadius="17" Background="{ThemeResource LpBrandBrush}">
                <TextBlock x:Name="MiniInitials" Foreground="White" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="MiniName" FontSize="14" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" MaxLines="1" MaxWidth="180" />
                <!-- Замок здесь по той же причине, что и на экране звонка: защита
                     договаривается на каждый разговор, и человек, свернувший софтфон
                     в мини-окно, не должен терять этот признак из виду. -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon x:Name="MiniLock" Glyph="&#xE72E;" FontSize="11" Foreground="Gray"
                              VerticalAlignment="Center" Visibility="Collapsed" />
                    <TextBlock x:Name="MiniStatus" FontSize="12" Foreground="Gray" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Входящий: принять / отклонить. Показывается вместо уведомления Windows —
             своё окно всегда поверх, не уезжает в центр уведомлений и не требует
             тянуться к главному окну. -->
        <StackPanel x:Name="IncomingButtons" Grid.Row="1" Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Center" Visibility="Collapsed">
            <Button Width="76" Height="34" Padding="0" Click="OnAccept" Background="#2BA84A"
                    ToolTipService.ToolTip="Принять">
                <FontIcon Glyph="&#xE717;" Foreground="White" FontSize="16" />
            </Button>
            <Button Width="76" Height="34" Padding="0" Click="OnDecline" Background="#C42B1C"
                    ToolTipService.ToolTip="Отклонить">
                <FontIcon Glyph="&#xE778;" Foreground="White" FontSize="16" />
            </Button>
        </StackPanel>

        <StackPanel x:Name="InCallButtons" Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button x:Name="MiniMute" Width="42" Height="34" Padding="0" Click="OnMute"
                    ToolTipService.ToolTip="Микрофон">
                <FontIcon x:Name="MiniMuteIcon" Glyph="&#xE720;" FontSize="16" />
            </Button>
            <Button x:Name="MiniHold" Width="42" Height="34" Padding="0" Click="OnHold"
                    ToolTipService.ToolTip="Удержание">
                <FontIcon x:Name="MiniHoldIcon" Glyph="&#xE769;" FontSize="16" />
            </Button>
            <Button x:Name="MiniOpen" Width="42" Height="34" Padding="0" Click="OnOpenMain"
                    ToolTipService.ToolTip="Открыть окно">
                <FontIcon Glyph="&#xE8A7;" FontSize="16" />
            </Button>
            <Button x:Name="MiniHangup" Width="52" Height="34" Padding="0" Click="OnHangup"
                    Background="#C42B1C" ToolTipService.ToolTip="Завершить">
                <FontIcon Glyph="&#xE778;" Foreground="White" FontSize="16" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
