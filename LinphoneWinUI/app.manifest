<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- Версия здесь НЕ та, что видит пользователь: в свойствах файла и в окне «О программе»
       показывается ресурс версии из csproj (<Version>). assemblyIdentity нужен только для
       side-by-side-привязки сборок и намеренно оставлен фиксированным — синхронизировать его
       с релизной версией нечем и незачем. -->
  <assemblyIdentity version="1.0.0.0" name="LinphoneWinUI.app" />

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <!-- Пути записи разговоров и выгрузок книги легко перешагивают 260 символов
           (профиль пользователя + дата + номер), без этого File.* падает на них. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
