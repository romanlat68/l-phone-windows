<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Официальный NuGet-фид Belledonne (GitLab) для LinphoneSDK.Windows.
       nuget.org остаётся (для Microsoft.WindowsAppSDK, H.NotifyIcon).
       Публичный проект — pull обычно анонимный; если restore попросит вход,
       добавь сюда <packageSourceCredentials> с персональным read-only токеном
       (НЕ коммить токен в git). -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="linphone-gitlab"
         value="https://gitlab.linphone.org/api/v4/projects/411/packages/nuget/index.json"
         protocolVersion="3" />
  </packageSources>

  <!-- GitLab-фид спрашиваем ТОЛЬКО про LinphoneSDK: иначе restore ходит туда за каждым
       пакетом (xunit, WindowsAppSDK, ...) и ловит 429 Too Many Requests. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="linphone-gitlab">
      <package pattern="LinphoneSDK.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
